# Copy to .env.local and edit. Every value has a working default in
# src/lib/config.js, so a plain checkout already points at the live GCR stack —
# these are only needed to point somewhere else.

# gcr-api-clean. Local API: http://localhost:3000
VITE_GCR_API_BASE=https://gcr-api-clean.vercel.app

# The GCR Supabase project (the same one gcr-api-clean reads and writes).
VITE_SUPABASE_URL=https://mkepugvdlktfsossumox.supabase.co

# Publishable anon key only. NEVER put the service_role key in a VITE_ variable
# — anything prefixed VITE_ is compiled into the browser bundle. The service key
# is passed to scripts/ through the SUPABASE_SERVICE_KEY environment variable at
# run time and is never read by the app.
VITE_SUPABASE_ANON_KEY=

# Businesses type their slug; it maps to <slug>@<this domain> for Supabase Auth.
# Must match the --domain used by scripts/provision-accounts.mjs.
VITE_LOGIN_DOMAIN=biz.gulfcoastradar.com
